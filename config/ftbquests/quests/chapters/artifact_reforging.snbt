					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			x: -2.0d
			y: -2.0d
		}
		{
			dependencies: ["6AD67E7C8CD78371"]
			description: [
				"&eモルテンエッジ2個とモルテンコアを使用することで鍛造できます。"
				""
				""
				"&8このアイテムはWorld of WarcraftのFyr'alathへのオマージュです。"
			]
			id: "6D1B83D633AB7558"
			shape: "hexagon"
			subtitle: "使用者に強力な耐性を与える、苦痛を与えるソウルファイア武器。タンク向きだが、火炎ダメージも大きい。"
			tasks: [{
