					type: "xp_levels"
					xp_levels: 2
				}
			]
			subtitle: "セルタス・クォーツ・クリスタルが手に入ったので、充電しましょう。先ほど作ったチャージャーに1つ入れて、クランキング開始です！"
			tasks: [{
				id: "1281175EA867EDB4"
				item: "ae2:charged_certus_quartz_crystal"
				type: "item"
			}]
			x: 3.5d
			y: -1.0d
		}
		{
			dependencies: ["1B26C03FD0CDAAEA"]
			id: "649045BE6DED01C9"
			rewards: [{
				count: 3
				id: "0D3C8EDC0D461667"
				item: "ae2:charged_certus_quartz_crystal"
				type: "item"
			}]
			subtitle: "このクリスタルは、エネルギーを吸収し、ある形態から別の形態へと変換する独自の能力を備えており、あらゆるME技術の基盤となっています。フルイックスクリスタルは、チャージされたセルタスクォーツクリスタル、ネザークォーツ、レッドストーンダストを水に入れることで作成できます。すぐに反応が始まり、フルイックスクリスタルへと変化します。"
			tasks: [{
				id: "13A7FC8BE40D58E0"
				item: "ae2:fluix_crystal"
				type: "item"
			}]
			x: 5.0d
			y: -1.0d
		}
		{
			dependencies: ["5962DB7143D9AD5F"]
