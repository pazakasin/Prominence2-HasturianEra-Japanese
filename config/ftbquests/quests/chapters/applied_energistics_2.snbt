				{
					id: "7C8731764F83270B"
					type: "xp_levels"
					xp_levels: 1
				}
			]
			shape: "gear"
			subtitle: "チャージャーは、MEネットワーク経由、またはクランクを使って手動で対応ツールを充電する方法を提供します。また、Certus Quartz CrystalからCharged Certus Quartz Crystalを、CompassからMeteorite Compassを作成することもできます。"
			tasks: [{
				id: "26755D4A4B6D447D"
				item: "ae2:charger"
				type: "item"
			}]
			title: "隕石探しの準備1"
			x: -1.0d
			y: 0.0d
		}
		{
			dependencies: ["35105F4914FBEC3B"]
			id: "452FE521007EE0D9"
			rewards: [{
				id: "6FEF03650DCF64BB"
				type: "xp_levels"
				xp_levels: 2
			}]
			subtitle: "隕石コンパスを作るには、通常のコンパスをチャージャーで充電します。これは、木製のクランクを使えばかなり早い段階で行えます。隕石コンパスは、2,700ブロックの範囲内にある最も近い隕石の方向を指します。コンパスが速く回転している場合は、チャンク内にスカイストーンがあります。コンパスの回転が遅い場合は、最も近い隕石の範囲外にあるため、さらに探索する必要があります。"
			tasks: [{
				id: "78C149237D81A6C9"
				item: "ae2:meteorite_compass"
				type: "item"
			}]
			title: "隕石探しの準備2"
			x: 0.5d
			y: 0.0d
		}
		{
			dependencies: ["452FE521007EE0D9"]
			id: "007FF6F71BEF7E3C"
			rewards: [
				{
					count: 5
					id: "7CE488318BA92052"
					item: "ae2:certus_quartz_crystal"
					type: "item"
				}
				{
					id: "372018AD002EAB96"
					type: "xp_levels"
					xp_levels: 3
				}
			]
			subtitle: "最初の隕石を探しに行く前に、鉄のツルハシかそれ以上のツルハシを用意しておきましょう。隕石はスカイストーンと呼ばれる非常に硬い素材でできており、スカイストーンが必要です。隕石の中心まで採掘して、セルタス水晶、セルタス水晶ブロック、そして刻印機を集めましょう！"
			tasks: [
				{
					id: "48E8D095ECE464DA"
					item: "ae2:quartz_block"
					type: "item"
				}
				{
					id: "7DC44DB8FC93E8D5"
					item: "ae2:sky_stone_block"
					type: "item"
				}
			]
			title: "あなたの最初の隕石"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["007FF6F71BEF7E3C"]
			id: "5962DB7143D9AD5F"
			rewards: [{
				id: "3B59CCFFB6854AD4"
				type: "xp_levels"
				xp_levels: 1
			}]
			subtitle: "インスクライバー・プレスは、隕石の中心にあるスカイチェストの中にあります。インスクライバーで回路を作成するために使用できます。"
			tasks: [
