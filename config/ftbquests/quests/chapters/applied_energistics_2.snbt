			rewards: [{
				id: "5B1B56388B2BA3D8"
				type: "xp_levels"
				xp_levels: 2
			}]
			shape: "gear"
			subtitle: "より高度な機械に必要な加工機を作るには、刻印機が必要です。加工機の種類ごとに専用のプレス機があり、隕石から入手できます。各加工には1k AEのチャージが必要です。"
			tasks: [{
				id: "16BB9E2C20ACE60D"
				item: "ae2:inscriber"
				type: "item"
			}]
